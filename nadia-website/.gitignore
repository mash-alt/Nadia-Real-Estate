# ── Dependencies ──────────────────────────────────────
node_modules/

# ── Build output ───────────────────────────────────────
dist/
dist-ssr/

# ── Environment variables (contain API keys/secrets) ───
.env
.env.*
!.env.example

# ── Source files with hardcoded credentials ────────────
