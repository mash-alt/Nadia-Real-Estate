scripts/

# Firebase client config (contains API key + project IDs)
src/config.ts

# ── Firebase local cache / debug logs ──────────────────
.firebase/
firebase-debug.log
firestore-debug.log
database-debug.log
ui-debug.log

# ── Large raw image assets (already on Cloudinary) ─────
public/assets/
src/assets/BE-Uptown/

# ── TypeScript build cache ─────────────────────────────
*.tsbuildinfo

# ── Logs ───────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── OS / Editor junk ───────────────────────────────────
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Misc ───────────────────────────────────────────────
*.local
coverage/
.cache/
